      "latex": "\n\\Lambda = \\mathcal{L}(\\mathbf{B}) = \\Big\\{ \\textstyle\\sum_{i=1}^{m} z_i\\,\\mathbf{b}_i : z_i \\in \\mathbb{Z} \\Big\\}.\n",
